
&НаСервере
Процедура ЗаполнитьСебестоимостьНаСервере()
	
	ВидОперацииТовары = Перечисления.ВидыОперацийРеализацияТоваров.Товары;
	
	// Получаем все документы
	ЗапросДокументов = Новый Запрос;
	ЗапросДокументов.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РеализацияТоваровУслугТовары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|ГДЕ
	|	РеализацияТоваровУслугТовары.Ссылка.ВидОперации = &Товары
	|	И РеализацияТоваровУслугТовары.Ссылка.Проведен";
	
	ЗапросДокументов.УстановитьПараметр("Товары", ВидОперацииТовары);
	
	РезультатДокументов = ЗапросДокументов.Выполнить();
	ВыборкаДокументов = РезультатДокументов.Выбрать();
	
	// Перебираем документы
	Пока ВыборкаДокументов.Следующий() Цикл
		ДокументСсылка = ВыборкаДокументов.Ссылка;
		
		// Получаем товары текущего документа
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
		|	РеализацияТоваровУслугТовары.Количество КАК Количество,
		|	РеализацияТоваровУслугТовары.ВесБрутто КАК ВесБрутто,
		|	РеализацияТоваровУслугТовары.Ссылка.Организация КАК Организация,
		|	РеализацияТоваровУслугТовары.Ссылка.Контрагент КАК Контрагент
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|ГДЕ
		|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		// Создаем набор записей для текущего документа
		НаборЗаписей = РегистрыНакопления.ПродажиТоваров.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ДокументСсылка);
		НаборЗаписей.Очистить(); // Удаляем старые записи
		
		// Добавляем новые записи
		Пока Выборка.Следующий() Цикл
			ЗаписьРегистра = НаборЗаписей.Добавить();
			ЗаписьРегистра.Регистратор = ДокументСсылка;
			ЗаписьРегистра.Период = ДокументСсылка.Дата;
			ЗаписьРегистра.РеализацияТоваров = ДокументСсылка;
			ЗаписьРегистра.Номенклатура = Выборка.Номенклатура;
			ЗаписьРегистра.Контрагент = Выборка.Контрагент;
			ЗаписьРегистра.Количество = Выборка.Количество;
			ЗаписьРегистра.ВесБрутто = Выборка.ВесБрутто;
		КонецЦикла;
		
		// Сохраняем
		НаборЗаписей.Записать();
		
	КонецЦикла;
	
	Сообщить("Регистр ПродажиТоваров заполнен!");
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСебестоимость(Команда)
	ЗаполнитьСебестоимостьНаСервере();
КонецПроцедуры
