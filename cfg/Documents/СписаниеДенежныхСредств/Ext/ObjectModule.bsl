
Процедура ОбработкаПроведения(Отказ, Режим)
	
	ТаблицаБлокировки = Новый ТаблицаЗначений;
	ТаблицаБлокировки.Колонки.Добавить("Организация");
	ТаблицаБлокировки.Колонки.Добавить("БанковскийСчет");
	
	НоваяСтрока = ТаблицаБлокировки.Добавить();
	НоваяСтрока.Организация = Организация;
	НоваяСтрока.БанковскийСчет = БанковскийСчет;
	
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрНакопления.ДенежныеСредства");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.ИсточникДанных = ТаблицаБлокировки;
	Элемент.ИспользоватьИзИсточникаДанных("Организация", "Организация");
	Элемент.ИспользоватьИзИсточникаДанных("БанковскийСчет", "БанковскийСчет");
	Блокировка.Заблокировать();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДенежныеСредстваОстатки.СуммаОстаток КАК СуммаОстаток
		|ИЗ
		|	РегистрНакопления.ДенежныеСредства.Остатки(
		|			&Дата,
		|			Организация = &Организация
		|				И БанковскийСчет = &БанковскийСчет) КАК ДенежныеСредстваОстатки";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("БанковскийСчет", БанковскийСчет);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Остаток = 0;
	Если Выборка.Следующий() Тогда
		Остаток = Выборка.СуммаОстаток;
	КонецЕсли;
	
	// Проверяем достаточно ли средств
	Если Остаток < СуммаДокумента Тогда
		Отказ = Истина;
		Нехватка = СуммаДокумента - Остаток;
		Сообщить("Недостаточно денежных средств на счете " + БанковскийСчет.Наименование + "! Не хватает: " + Нехватка + " руб.");
		Возврат;
	КонецЕсли;
	
	// регистр ДвиженияДенежныхСредств
	Движения.ДвиженияДенежныхСредств.Записывать = Истина;
	Движение = Движения.ДвиженияДенежныхСредств.Добавить();
	Движение.Период = Дата;
	Движение.Организация = Организация;
	Движение.СтатьяДДС = СтатьяДДС;
	Движение.СуммаПриход = 0;
	Движение.СуммаРасход = СуммаДокумента;
	Движение.Аналитики = ?(СтатьяДДС.Родитель.Код = "000000007", Контрагент, Сотрудник); 	
	
	// регистр ДенежныеСредства
	Движения.ДенежныеСредства.Записывать = Истина;
	Движение = Движения.ДенежныеСредства.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
	Движение.Период = Дата;
	Движение.Организация = Организация;
	Движение.БанковскийСчет = БанковскийСчет;
	Движение.Сумма = СуммаДокумента;
	
	//Бух учет
	Движения.Основной.Записывать = Истина;
	
	ДвижениеБух = Движения.Основной.Добавить();
	ДвижениеБух.Период = Дата;
	ДвижениеБух.Организация = Организация;
	ДвижениеБух.Сумма = СуммаДокумента;
	
	Если СтатьяДДС.Родитель.Код = "000000007" Тогда
		ДвижениеБух.СчетДт = ПланыСчетов.Основной.РасчетыСПоставщиками;
		БухгалтерскийУчет.УстановитьСубконто(ДвижениеБух.СчетДт, ДвижениеБух.СубконтоДт, "Контрагенты", Контрагент);
	Иначе
		ДвижениеБух.СчетДт = ПланыСчетов.Основной.РасчетыСПодотчетнымиЛицами;
		БухгалтерскийУчет.УстановитьСубконто(ДвижениеБух.СчетДт, ДвижениеБух.СубконтоДт, "Сотрудники", Сотрудник);
	КонецЕсли;
	
	ДвижениеБух.СчетКт = ПланыСчетов.Основной.РасчетныеСчета;
	БухгалтерскийУчет.УстановитьСубконто(ДвижениеБух.СчетКт, ДвижениеБух.СубконтоКт, "БанковскиеСчета", БанковскийСчет);
	
КонецПроцедуры

