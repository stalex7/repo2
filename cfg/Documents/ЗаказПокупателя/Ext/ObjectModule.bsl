
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	СуммаДокумента = Товары.Итог("Сумма");
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	Движения.РезервыТоваров.Записывать = Истина;
	Движения.ЗаказыПокупателей.Записывать = Истина;
	
	Для Каждого ТекСтрокаТовары Из Товары Цикл
		Если ТекСтрокаТовары.Отменен Тогда
			ДвижениеЗаказ = Движения.ЗаказыПокупателей.Добавить();
			ДвижениеЗаказ.Период = Дата;
			ДвижениеЗаказ.Номенклатура = ТекСтрокаТовары.Номенклатура;
			ДвижениеЗаказ.Организация = Организация;
			ДвижениеЗаказ.Контрагент = Контрагент;
			ДвижениеЗаказ.ЗаказПокупателя = Ссылка;
			ДвижениеЗаказ.КоличествоОтменено = ТекСтрокаТовары.Количество; 
			Продолжить;
		КонецЕсли;
		Движение = Движения.РезервыТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Организация = Организация;
		Движение.Номенклатура = ТекСтрокаТовары.Номенклатура;
		Движение.Склад = Склад;
		Движение.ЗаказПокупателя = Ссылка;
		Движение.Количество = ТекСтрокаТовары.Количество;
		
		ДвижениеЗаказ = Движения.ЗаказыПокупателей.Добавить();
		ДвижениеЗаказ.Период = Дата;
		ДвижениеЗаказ.Номенклатура = ТекСтрокаТовары.Номенклатура;
		ДвижениеЗаказ.Организация = Организация;
		ДвижениеЗаказ.Контрагент = Контрагент;
		ДвижениеЗаказ.ЗаказПокупателя = Ссылка;
		ДвижениеЗаказ.КоличествоЗаказано = ТекСтрокаТовары.Количество;
		ДвижениеЗаказ.Сумма = ТекСтрокаТовары.Сумма;
		ДвижениеЗаказ.Себестоимость = РассчитатьСебестоимостьТовара(ТекСтрокаТовары.Номенклатура, Организация, Дата, ТекСтрокаТовары.Количество);

	КонецЦикла;

КонецПроцедуры

Функция РассчитатьСебестоимостьТовара(Номенклатура, Организация, Дата, КоличествоЗаказано)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.КоличествоОстаток КАК Количество,
	|	Остатки.СуммаОстаток КАК Сумма
	|ИЗ
	|	РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Дата, ) КАК Остатки
	|ГДЕ
	|	Остатки.Номенклатура = &Номенклатура
	|	И Остатки.Организация = &Организация";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Дата", Дата);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Количество = 0;
	Сумма = 0;
	
	Пока Выборка.Следующий() Цикл
		Количество = Количество + Выборка.Количество;
		Сумма = Сумма + Выборка.Сумма;
	КонецЦикла;
	
	Если Количество > 0 Тогда
		Себестоимость = Сумма / Количество;
		СебестоимостьТовара = Себестоимость * КоличествоЗаказано;
	Иначе
		СебестоимостьТовара = 0;
	КонецЕсли;
	
	Возврат СебестоимостьТовара;
	
КонецФункции
