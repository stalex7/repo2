		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЗаказПокупателя.Ссылка КАК Заказ,
	РасходнаяНакладная.Ссылка КАК Документ,
	ЗаказПокупателя.СуммаДокумента КАК СуммаЗаказа,
	ЕСТЬNULL(РасходнаяНакладная.СуммаДокумента, 0) КАК СуммаДокумента
ИЗ
	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РасходнаяНакладная КАК РасходнаяНакладная
		ПО ЗаказПокупателя.Ссылка = РасходнаяНакладная.ДокументОснование
ГДЕ
	ЗаказПокупателя.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И ЗаказПокупателя.Проведен</query>
	</dataSet>
