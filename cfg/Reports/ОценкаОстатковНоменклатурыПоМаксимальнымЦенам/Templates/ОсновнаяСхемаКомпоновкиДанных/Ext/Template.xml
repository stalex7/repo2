		<field xsi:type="DataSetFieldField">
			<dataPath>СтоимостьПоМаксимальнымЦенам</dataPath>
			<field>СтоимостьПоМаксимальнымЦенам</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Стоимость по максимальным ценам</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ОсновнойОстатки.Организация КАК Организация,
	ОсновнойОстатки.Субконто1 КАК Номенклатура,
	ОсновнойОстатки.Субконто2 КАК Склад,
	ОсновнойОстатки.СуммаОстаток КАК СуммаОстаток,
	ОсновнойОстатки.КоличествоОстаток КАК КоличествоОстаток
ПОМЕСТИТЬ ВТОстатки
ИЗ
	РегистрБухгалтерии.Основной.Остатки(&amp;ДатаОтчета, Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ТоварыНаСкладах), , ) КАК ОсновнойОстатки
ГДЕ
	ОсновнойОстатки.КоличествоОстаток &gt; 0
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЦеныНоменклатуры.Номенклатура КАК Номенклатура,
	МАКСИМУМ(ЦеныНоменклатуры.Цена) КАК МаксимальнаяЦена
ПОМЕСТИТЬ ВТМаксимальнаяЦена
ИЗ
	РегистрСведений.ЦеныНоменклатуры КАК ЦеныНоменклатуры

СГРУППИРОВАТЬ ПО
	ЦеныНоменклатуры.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТОстатки.Организация КАК Организация,
	ВТОстатки.Номенклатура КАК Номенклатура,
	ВТОстатки.Склад КАК Склад,
	ВТОстатки.СуммаОстаток КАК СуммаОстаток,
	ВТОстатки.КоличествоОстаток КАК КоличествоОстаток,
	ВЫБОР
		КОГДА ВТОстатки.КоличествоОстаток = 0
			ТОГДА 0
		ИНАЧЕ ОКР(ВТОстатки.СуммаОстаток / ВТОстатки.КоличествоОстаток, 2)
	КОНЕЦ КАК Себестоимость,
	ОКР(ЕСТЬNULL(ВТМаксимальныеЦены.МаксимальнаяЦена, 0) * ВТОстатки.КоличествоОстаток, 2) КАК СтоимостьПоМаксимальнымЦенам
ИЗ
	ВТОстатки КАК ВТОстатки
		ЛЕВОЕ СОЕДИНЕНИЕ ВТМаксимальнаяЦена КАК ВТМаксимальныеЦены
		ПО ВТОстатки.Номенклатура = ВТМаксимальныеЦены.Номенклатура</query>
	</dataSet>
