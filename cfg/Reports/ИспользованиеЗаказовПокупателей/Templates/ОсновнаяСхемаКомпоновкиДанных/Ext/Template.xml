		<field xsi:type="DataSetFieldField">
			<dataPath>ОсталосьОтгрузить</dataPath>
			<field>ОсталосьОтгрузить</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Осталось отгрузить</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	РезервыТоваровОстатки.Организация КАК Организация,
	РезервыТоваровОстатки.Номенклатура КАК Номенклатура,
	РезервыТоваровОстатки.ЗаказПокупателя КАК ЗаказПокупателя,
	СУММА(РезервыТоваровОстатки.КоличествоОстаток) КАК КоличествоОстаток
ПОМЕСТИТЬ втРезервы
ИЗ
	РегистрНакопления.РезервыТоваров.Остатки КАК РезервыТоваровОстатки

СГРУППИРОВАТЬ ПО
	РезервыТоваровОстатки.Номенклатура,
	РезервыТоваровОстатки.Организация,
	РезервыТоваровОстатки.ЗаказПокупателя
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	втРезервы.Номенклатура КАК Номенклатура,
	втРезервы.Организация КАК Организация,
	втРезервы.ЗаказПокупателя КАК ЗаказПокупателя,
	ПродажиОбороты.Контрагент КАК Контрагент,
	втРезервы.КоличествоОстаток КАК КоличествоОстаток,
	ПродажиОбороты.КоличествоОборот КАК КоличествоОборот,
	ЕСТЬNULL(втРезервы.КоличествоОстаток - ПродажиОбороты.КоличествоОборот, 0) КАК ОсталосьОтгрузить
ИЗ
	втРезервы КАК втРезервы
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи.Обороты(, , , {(Контрагент = &amp;Контрагент
				    И Номенклатура В (&amp;Номенклатура))}) КАК ПродажиОбороты
		ПО втРезервы.Номенклатура = ПродажиОбороты.Номенклатура
			И втРезервы.Организация = ПродажиОбороты.Организация
{ГДЕ
	(втРезервы.ЗаказПокупателя В (&amp;ЗаказПокупателя))}</query>
